  DocumentUrl: https://selvakumaresra.github.io/superwhatsapp/getting-started/
- DocumentLabel: Settings and Files
  DocumentUrl: https://selvakumaresra.github.io/superwhatsapp/settings-and-files/
ManifestType: defaultLocale
ManifestVersion: 1.12.0
