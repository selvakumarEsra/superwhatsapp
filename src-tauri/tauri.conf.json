{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperWhatsapp",
  "identifier": "me.paolino.fastsapp",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SuperWhatsapp",
        "width": 1440,
        "height": 900,
        "minWidth": 750,
        "minHeight": 512,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 18
        },
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: zapmedia: http://zapmedia.localhost; media-src 'self' zapmedia: http://zapmedia.localhost; connect-src ipc: http://ipc.localhost; font-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A fast WhatsApp client",
    "publisher": "SuperWhatsapp",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
